[Unit]
Description=Codex background executor (codex-bg tmux session, --profile deep)
After=network-online.target
Wants=network-online.target

[Service]
Type=forking
Environment=PATH=/home/yagi/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=TERM=xterm-256color
WorkingDirectory=/mnt/d/AI/projects/yagi-workshop
ExecStart=/usr/bin/tmux -L codex-bg new-session -d -s codex-bg /mnt/d/AI/scripts/router/codex_bg_launch.sh
ExecStop=/usr/bin/tmux -L codex-bg kill-server
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
